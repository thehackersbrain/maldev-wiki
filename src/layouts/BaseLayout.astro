---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site, absolute } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** structured data objects; serialised into one ld+json block per entry */
  jsonLd?: Record<string, unknown>[];
  /** set on pages that should stay out of the index */
  noindex?: boolean;
  /** article pages emit publish/modify times and an author */
  article?: { published: string; modified: string; author: string; section: string };
  /** overrides the default social card */
  ogImage?: string;
}

const {
  title,
  description = site.description,
  jsonLd = [],
  noindex = false,
  article,
  ogImage = site.ogImage,
} = Astro.props;

// Astro.site is set in astro.config.ts, so this is always absolute.
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const socialImage = absolute(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0b0e" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

    {
      article && (
        <>
          <meta property="article:published_time" content={article.published} />
          <meta property="article:modified_time" content={article.modified} />
          <meta property="article:author" content={article.author} />
          <meta property="article:section" content={article.section} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — recently updated`}
      href={absolute('/rss.xml', Astro.site)}
    />

    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="min-h-screen bg-bg text-tx">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-100 focus:rounded-lg focus:border focus:border-accd focus:bg-panel focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-acc"
      >Skip to content</a
    >
    <Header />
    <slot />

    <script>
      // ⌘K / ctrl-K and "/" jump to search from anywhere.
      document.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement | null;
        const typing =
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target?.isContentEditable;

        const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
        const isSlash = e.key === '/' && !typing && !e.metaKey && !e.ctrlKey;
        if (!isCmdK && !isSlash) return;

        e.preventDefault();
        const box = document.querySelector<HTMLInputElement>('[data-search-input]');
        if (box) {
          box.focus();
          box.select();
        } else {
          window.location.href = '/search';
        }
      });
    </script>
  </body>
</html>
