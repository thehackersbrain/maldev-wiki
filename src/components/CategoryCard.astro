---
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  /** published pages in this category */
  count: number;
}

const { category, count } = Astro.props;
---

<a
  href={`/techniques/${category.slug}`}
  class="flex flex-col gap-2 rounded-[11px] border border-bd bg-bg2 p-4 transition-colors hover:border-accd hover:bg-panel"
>
  <span
    class="grid h-8 w-8 place-items-center rounded-lg border border-acc/20 bg-acc/8 font-mono text-[17px] leading-none font-semibold text-acc"
    aria-hidden="true">{category.sym}</span
  >
  <span class="text-[13.5px]/[1.3] font-semibold text-tx">{category.name}</span>
  <span class="text-[11.5px]/[1.4] text-faint">{category.sub}</span>
  <span class="mt-1 font-mono text-[10px] text-faint">
    {count} {count === 1 ? 'page' : 'pages'}
  </span>
</a>
