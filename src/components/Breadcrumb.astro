---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav
  class="mb-5 flex flex-wrap items-center gap-2 font-mono text-xs/[1.4] font-medium text-faint"
  aria-label="Breadcrumb"
>
  {
    items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} class="text-dim hover:text-tx">
              {item.label}
            </a>
          ) : (
            <span class:list={[isLast ? 'text-acc' : 'text-dim']} aria-current={isLast ? 'page' : undefined}>
              {item.label}
            </span>
          )}
        </>
      );
    })
  }
</nav>
