---
interface Props {
  /** rendered after the "# " prefix, in mono, like a shell comment */
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<h2
  class:list={[
    'font-mono text-[13px] font-semibold tracking-[0.03em] text-dim',
    className ?? 'mb-3.5',
  ]}
>
  # {text}<slot />
</h2>
