---
interface Props {
  /** accent pills carry the primary identifier (a MITRE id); the rest are neutral */
  tone?: 'neutral' | 'accent';
  size?: 'sm' | 'xs';
  class?: string;
}

const { tone = 'neutral', size = 'sm', class: className } = Astro.props;
---

<span
  class:list={[
    'rounded-[5px] border font-mono font-medium whitespace-nowrap',
    tone === 'accent' ? 'border-acc/26 bg-acc/10 text-acc' : 'border-bd bg-panel text-dim',
    size === 'sm' ? 'px-2.25 py-1.5 text-[11px]' : 'px-1.5 py-0.75 text-[10px]/[1.3] text-faint',
    className,
  ]}
>
  <slot />
</span>
