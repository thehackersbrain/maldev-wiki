---
interface Related {
  mitre: string;
  title: string;
  desc: string;
  href?: string;
}

interface Props {
  items: Related[];
}

const { items } = Astro.props;
---

<div class="mb-9 flex flex-col gap-2">
  {
    items.map((r) => {
      const Tag = r.href ? 'a' : 'div';
      return (
        <Tag
          href={r.href}
          class:list={[
            'flex flex-wrap items-center gap-x-3.5 gap-y-1 rounded-[10px] border border-bd bg-bg2 px-4 py-3.25',
            r.href && 'transition-colors hover:border-accd hover:bg-panel',
          ]}
        >
          <span class="w-[78px] flex-none font-mono text-[10px]/[1.3] font-semibold text-faint">
            {r.mitre}
          </span>
          <span class="flex-none text-[13.5px] font-semibold text-tx">{r.title}</span>
          <span class="min-w-0 flex-1 text-[12.5px]/[1.4] text-dim">{r.desc}</span>
          {r.href && <span class="font-mono text-[13px] font-medium text-acc">→</span>}
        </Tag>
      );
    })
  }
</div>
