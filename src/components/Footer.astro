---
import { site, creator } from '../lib/seo';

const year = new Date().getFullYear();
---

<footer
  class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-bd pt-5.5 pb-15 font-mono text-xs/[1.6] text-faint"
>
  <span>© {year} {site.name}</span><span aria-hidden="true">·</span>
  <span>CC BY-SA 4.0</span><span aria-hidden="true">·</span>
  <!-- the stamp is machine metadata; the notice is prose -->
  <span class="font-sans text-[13px]"
    >Published for defensive research and authorized testing only.</span
  >
  <span class="w-full font-sans text-[13px] sm:ml-auto sm:w-auto">
    Built by <a href={creator.url} rel="noopener me" class="text-acc hover:text-acc2"
      >{creator.name}</a
    >
    <span class="font-mono text-[12px] text-faint">(@{creator.handle})</span>
  </span>
</footer>
