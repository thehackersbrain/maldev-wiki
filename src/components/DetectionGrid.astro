---
interface Detection {
  /** telemetry source, e.g. "SYSMON EID 8" */
  src: string;
  text: string;
}

interface Props {
  items: Detection[];
}

const { items } = Astro.props;
---

<div class="mb-7.5 grid gap-3 sm:grid-cols-2">
  {
    items.map((d) => (
      <div class="rounded-[10px] border border-bd bg-panel px-4 py-3.5">
        <div class="mb-2 font-mono text-[11px] font-semibold tracking-[0.05em] text-acc">
          {d.src}
        </div>
        <div class="text-[13px]/[1.6] text-pretty text-tx2">{d.text}</div>
      </div>
    ))
  }
</div>
